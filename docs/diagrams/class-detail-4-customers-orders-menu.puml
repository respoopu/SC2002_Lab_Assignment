' The model is in class-model.iuml; render with render.sh.
!$getters = %false()
!$links_boundary = %false()
!$links_control = %false()
!$links_restaurant = %false()
!$links_orders = %true()
!include class-model.iuml
!include class-dependencies.iuml
!include class-notes-orders.iuml
!include class-legend.iuml
remove $x4
hide Table members
hide TurnLog members
' layout hints only (no meaning)
Customer -[hidden]right- CustomerStatus
Table -[hidden]right- Customer
Menu -[hidden]right- Order
title Restaurant Rush - class diagram, detail 4 of 4: customers, orders and the menu (tag stage-3)\nBoxes without compartments are detailed on another page.
@enduml
