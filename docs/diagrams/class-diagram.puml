    ~ {static} play(in : InputStream, out : PrintStream, echo : boolean) : void
  }

  class GameCLI {
    - in : Scanner
    - out : PrintStream
    - echoInput : boolean
    - view : StatusView
    + GameCLI(in : InputStream, out : PrintStream, echoInput : boolean)
    + showTurnHeader(turn : int, maxTurns : int) : void
    + showMessage(message : String) : void
    + showState(r : Restaurant, s : Scoreboard, tasks : List<String>) : void
    + askActivateHappyHour(h : HappyHour) : boolean
    + chooseHostSeating(r : Restaurant) : Optional<Seating>
    + chooseWaiterTask(r : Restaurant) : WaiterTask
    + chooseOrderToCook(r : Restaurant) : Optional<Order>
    + showTurnEnd(turn : int, maxTurns : int, s : Scoreboard) : void
    + showResult(victory : boolean, s : Scoreboard, c : GameConfig) : void
    - pickCustomerToSeat(question : String, r : Restaurant) : Optional<Customer>
    - pick<T>(question : String, options : List<T>, label : Function<T,String>) : Optional<T>
    - readChoice(prompt : String, min : int, max : int) : int
    - nextAnswer() : String
  }

  class StatusView {
    + header(turn : int, maxTurns : int) : String
    + state(r : Restaurant, s : Scoreboard, tasks : List<String>) : String
    + describeCustomer(c : Customer) : String
    + describeOrder(o : Order) : String
    + describeTable(t : Table) : String
    + turnEnd(turn : int, maxTurns : int, s : Scoreboard) : String
    + result(victory : boolean, s : Scoreboard, c : GameConfig) : String
    + {static} average(s : Scoreboard) : String
  }

  class InputEndedException <<RuntimeException>> {
    + InputEndedException()
  }
}

package "restaurantrush.control  <<control>>" as control #F4FBF4 {
  interface GameUI <<interface>> {
    + showTurnHeader(turn : int, maxTurns : int) : void
    + showMessage(message : String) : void
    + showState(r : Restaurant, s : Scoreboard, tasks : List<String>) : void
    + askActivateHappyHour(h : HappyHour) : boolean
    + chooseHostSeating(r : Restaurant) : Optional<Seating>
    + chooseWaiterTask(r : Restaurant) : WaiterTask
    + chooseOrderToCook(r : Restaurant) : Optional<Order>
    + showTurnEnd(turn : int, maxTurns : int, s : Scoreboard) : void
    + showResult(victory : boolean, s : Scoreboard, c : GameConfig) : void
  }

  class GameController {
    - config : GameConfig
    - restaurant : Restaurant
    - scoreboard : Scoreboard
    - schedule : ArrivalSchedule
    - host : Host
    - waiter : Waiter
    - chef : Chef
    - cashier : Cashier
    - ui : GameUI
    - turn : int
    + GameController(GameConfig, Restaurant, ArrivalSchedule,\n    Host, Waiter, Chef, Cashier, GameUI)
    + run() : boolean
    ~ playTurn(t : int) : void
    + currentTurn() : int
    + scoreboard() : Scoreboard
    - happyHourStep() : void
    - hostStep() : void
    - waiterStep() : void
    - execute(task : WaiterTask) : ActionResult
    - chefStep() : void
    - report(result : ActionResult) : void
    - flushLog() : void
    - waiterHasWork() : boolean
    - availableTasks() : List<String>
  }

  class GameSetup <<final>> {
    + {static} EDITION : String
    - GameSetup()
    + {static} baseMenu() : Menu
    + {static} baseGame(ui : GameUI) : GameController
  }

  class GameConfig <<record>> {
    - maxTurns : int
    - tableCount : int
    - targetPaidCustomers : int
    - targetRevenue : Money
    - targetAverageSatisfaction : int
    + {static} base() : GameConfig
    + paidTargetMet(paidCount : int) : boolean
    + revenueTargetMet(revenue : Money) : boolean
    + satisfactionTargetMet(satisfactionSum : int, paidCount : int) : boolean
    + isVictory(s : Scoreboard) : boolean
  }

  class ArrivalSchedule {
    - arrivals : TreeMap<Integer, BiFunction<Integer,Integer,Customer>>
    + add(turn : int, factory : BiFunction<Integer,Integer,Customer>) : ArrivalSchedule
    + arrivalAt(turn : int) : Optional<Customer>
    + {static} base() : ArrivalSchedule
  }

  class WaiterTask <<record>> {
    - kind : WaiterTask.Kind
    - customer : Customer
    - table : Table
    - order : Order
    + {static} seat(c : Customer, t : Table) : WaiterTask
    + {static} takeOrder(c : Customer) : WaiterTask
    + {static} serve(o : Order) : WaiterTask
    + {static} waitTurn() : WaiterTask
  }

  enum "WaiterTask.Kind" as Kind <<enumeration>> {
    SEAT
    TAKE_ORDER
    SERVE
    WAIT
  }

  class Seating <<record>> {
    - customer : Customer
    - table : Table
  }

  note top of GameUI
    <b>Dependency inversion</b>
    GameController depends on the GameUI interface,
    which lives in the control package. GameCLI (and
    the scripted test doubles) implement it, so no game
    rule lives in the console code and whole games run
    in JUnit.
  end note
}

